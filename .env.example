# Copy this file to .env.local and replace values for your environment.
MONGODB_URI=mongodb://127.0.0.1:27017/asia_lms
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Used only by `npm run create-admin`; never set these in browser code.
ADMIN_BOOTSTRAP_NAME=Platform Admin
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Kashier payment sessions. Use test credentials while developing.
KASHIER_MODE=test
KASHIER_MERCHANT_ID=
KASHIER_SECRET_KEY=
KASHIER_API_KEY=
KASHIER_PAYMENT_API_KEY=
